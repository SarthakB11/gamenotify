# Copy to .env (optional). Every variable has a safe dev default; see docs/LLD.md §8.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Required when NODE_ENV=production (16+ random characters each, e.g. `openssl rand -hex 24`):
# AUTH_SECRET=
# INTERNAL_API_KEY=
# Listen address: 127.0.0.1 by default, 0.0.0.0 in production (set it to 0.0.0.0 to reach a dev server from another machine):
# HOST=127.0.0.1
GROUP_WINDOW_MS=10000
RATE_CAPACITY=20
MIN_ITEM_RARITY=RARE
